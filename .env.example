# =============================================================================
# Trading System Environment Variables
# =============================================================================
# Copy to .env and fill in values. NEVER commit .env to version control.

# --- Trading Mode ---
# DEVELOPMENT | BACKTEST | SHADOW | PAPER | TESTNET | LIMITED_LIVE | LIVE
# LIVE requires explicit human approval. Default: DEVELOPMENT
TRADING_MODE=DEVELOPMENT

# --- Database ---
DATABASE_PATH=data/trading.db

# --- Exchange (DO NOT fill during development) ---
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_TESTNET=true

# --- Logging ---
LOG_LEVEL=DEBUG
LOG_FILE=logs/trading.log

# --- Obsidian Knowledge Layer ---
# OBSIDIAN_VAULT_PATH=~/obsidian-vault

# --- Risk Policy ---
RISK_POLICY_FILE=configs/risk.yaml
